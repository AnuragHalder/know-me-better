# Copy to .env.local for local development. Never commit real values.
# Vercel: add the same names under Project Settings > Environment Variables.

# Public address of the live site (no trailing slash). Used for link previews,
# the sitemap and policy pages. In Vercel: https://whoknowsmebetter.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Main domain, without https://. When set in Vercel (Production only), visitors on
# *.vercel.app or www. are redirected here. Leave empty until the domain works.
# CANONICAL_HOST=whoknowsmebetter.in

# Supabase (Project Settings > API). Used by the app from Phase 3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Needed from Phase 8 (payments).
# SUPABASE_SERVICE_ROLE_KEY=

# Database migrations are applied by GitHub Actions, not the app. They use repository
# secrets SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD and SUPABASE_PROJECT_REF.

# Razorpay (Phase 8). Server only. Test keys start rzp_test_, live keys rzp_live_.
# See docs/RAZORPAY.md.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# OpenAI for AI-written questions (Phase 5b). Server only.
# OPENAI_API_KEY=
# OPENAI_MODEL=

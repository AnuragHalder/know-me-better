# Copy to .env.local for local development. Never commit real values.
# Vercel: add the same names under Project Settings > Environment Variables.

# Public site address, used in share links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Used by the app from Phase 3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Needed from Phase 8 (payments).
# SUPABASE_SERVICE_ROLE_KEY=

# Database migrations are applied by GitHub Actions, not the app. They use repository
# secrets SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD and SUPABASE_PROJECT_REF.

# Added in Phase 8 (Razorpay)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
